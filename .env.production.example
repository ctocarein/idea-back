# =============================================================================
# Ideaxion backend — .env de PRODUCTION (modèle). À copier en `.env` SUR LE SERVEUR.
# NE JAMAIS versionner le vrai .env. Les valeurs marquées 🔐 sont des SECRETS.
# =============================================================================

APP_ENV=production
LOG_LEVEL=INFO

# --- Sécurité 🔐 (générer : openssl rand -hex 32) ---
JWT_SECRET=__CHANGE_ME_32_bytes__

# --- PostgreSQL 🔐 ---
POSTGRES_PASSWORD=__CHANGE_ME__
# DATABASE_URL est composée par docker-compose.prod.yml (postgres managé : la surcharger ici).

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (origines front autorisées) ---
CORS_ORIGINS=https://app.ideaxion.app

# --- OAuth (Google / LinkedIn) 🔐 ---
# redirect_uri à enregistrer chez les fournisseurs : {BACKEND_BASE_URL}/api/v1/auth/oauth/{provider}/callback
BACKEND_BASE_URL=https://api.ideaxion.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Email : vérification d'adresse 🔐 ---
# PUBLIC_BASE_URL = URL du FRONT. C'est elle qui compose le lien de vérification ;
# laissée au défaut (localhost:3000), tout email parti contient un lien mort.
PUBLIC_BASE_URL=https://app.ideaxion.app
# SMTP_HOST vide = aucun envoi, lien seulement dans les logs → un inconnu ne peut pas
# valider son compte. En production, ce champ n'est pas optionnel.
SMTP_HOST=__CHANGE_ME__
SMTP_PORT=587                        # 587 = STARTTLS · 465 = TLS implicite
SMTP_USER=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_TLS=                            # vide = déduit du port
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=IDEAXION <no-reply@ideaxion.cloud>

# --- LLM 🔐 (UE/RGPD en primaire) ---
LLM_PROVIDER=mistral
LLM_FALLBACKS=deepseek
MISTRAL_API_KEY=__CHANGE_ME__
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- MinIO / S3 🔐 ---
# INTERNE : par où l'api/worker joignent MinIO dans le réseau Docker.
MINIO_ENDPOINT=minio:9000
# PUBLIC : l'hôte qui signe les URLs présignées, donc celui que le NAVIGATEUR du porteur
# doit pouvoir résoudre. Laissé sur `minio:9000`, aucun bilan n'est téléchargeable et
# aucun document n'est uploadable — la panne est silencieuse côté serveur.
# À exposer derrière le reverse proxy (ex. https://files.ideaxion.app).
MINIO_PUBLIC_ENDPOINT=files.ideaxion.app
MINIO_PUBLIC_SECURE=true   # TLS terminé par le proxy devant un MinIO en clair
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_BUCKET=ideaxion
MINIO_SECURE=false   # true si MinIO/S3 derrière TLS
MINIO_REGION=
MINIO_TIMEOUT_SECONDS=5
MINIO_MAX_ATTEMPTS=3
MINIO_CIRCUIT_FAILURE_THRESHOLD=3
MINIO_CIRCUIT_RESET_SECONDS=30

# --- Observabilité (optionnel) ---
# SENTRY_DSN=
