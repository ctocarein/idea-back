# =============================================================================
# Ideaxion backend — .env de STAGING (modèle). À copier en `.env.staging` SUR LE VPS.
# NE JAMAIS versionner le vrai .env.staging.
# Les valeurs 🔐 sont des secrets — générer ou récupérer depuis le gestionnaire de secrets.
# =============================================================================

APP_ENV=staging
LOG_LEVEL=INFO

# --- Sécurité 🔐 ---
# Générer : openssl rand -hex 32
JWT_SECRET=__CHANGE_ME_32_bytes__

# --- PostgreSQL 🔐 ---
POSTGRES_PASSWORD=__CHANGE_ME__

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (front staging) ---
CORS_ORIGINS=https://staging.ideaxion.cloud

# --- LLM 🔐 ---
LLM_PROVIDER=mistral
LLM_FALLBACKS=deepseek
MISTRAL_API_KEY=__CHANGE_ME__
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- MinIO 🔐 ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_BUCKET=ideaxion-staging
MINIO_SECURE=false
