# =============================================================================
# Ideaxion backend — variables d'environnement (.env.example)
# Aucune valeur secrète ici : ce fichier est versionné, le vrai .env ne l'est pas.
# La config est validée AU DÉMARRAGE (fail-fast) — cf. app/core/config.py.
# =============================================================================

# --- Application ---
APP_ENV=local                       # local | staging | production
APP_NAME=ideaxion-backend
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- Base de données (PostgreSQL) ---
# Le driver asyncpg est forcé côté code si absent ; postgresql:// suffit.
DATABASE_URL=postgresql://ideaxion:ideaxion@localhost:5432/ideaxion

# --- Cache / sessions / rate-limit (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Sécurité (JWT) ---
# Secret de signature HMAC-SHA256. Générer : `openssl rand -hex 32`.
JWT_SECRET=change-me-with-a-32-byte-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# Liste blanche des origines autorisées (front Next.js).
CORS_ORIGINS=http://localhost:3000

# --- Abstraction LLM (app/llm) ---
# mock = provider déterministe sans réseau (dev/tests, pipeline diagnostic de bout en bout).
LLM_PROVIDER=deepseek                # mock | deepseek | mistral | openai | gemini
LLM_FALLBACKS=mistral                # repli(s) si le primaire échoue (clé requise), ex. "mistral,openai"
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modèles (surchargables) — petits modèles par défaut (coût freemium).
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-small-latest
OPENAI_MODEL=gpt-4o-mini
# Paramètres d'appel (température basse = reproductibilité ; timeout LLM = 30s).
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- Stockage objet (MinIO, S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ideaxion
MINIO_SECRET_KEY=ideaxion-secret
MINIO_BUCKET=ideaxion
MINIO_SECURE=false                   # true en prod (HTTPS)
