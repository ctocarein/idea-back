# =============================================================================
# Ideaxion backend — variables d'environnement (.env.example)
# Aucune valeur secrète ici : ce fichier est versionné, le vrai .env ne l'est pas.
# La config est validée AU DÉMARRAGE (fail-fast) — cf. app/core/config.py.
# =============================================================================

# --- Application ---
APP_ENV=local                       # local | staging | production
APP_NAME=ideaxion-backend
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- Base de données (PostgreSQL) ---
# Le driver asyncpg est forcé côté code si absent ; postgresql:// suffit.
DATABASE_URL=postgresql://ideaxion:ideaxion@localhost:5432/ideaxion
# Port hôte exposé par docker-compose (défaut 5432). Doit correspondre au port
# de DATABASE_URL ci-dessus. Mets 25432 (ici ET dans l'URL) si 5432 est déjà pris.
# POSTGRES_PORT=5432

# --- Cache / sessions / rate-limit (Redis) ---
REDIS_URL=redis://localhost:6379/0
# REDIS_PORT=6379

# --- Sécurité (JWT) ---
# Secret de signature HMAC-SHA256. Générer : `openssl rand -hex 32`.
JWT_SECRET=change-me-with-a-32-byte-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ---
# Liste blanche des origines autorisées (front Next.js).
CORS_ORIGINS=http://localhost:3000

# --- OAuth (connexion Google / LinkedIn) ---
# URL publique du BACKEND : sert à construire le redirect_uri déclaré aux fournisseurs.
# Doit être enregistrée à l'identique dans la console Google/LinkedIn :
#   {BACKEND_BASE_URL}/api/v1/auth/oauth/{google|linkedin}/callback
BACKEND_BASE_URL=http://localhost:8080
# Laisser vide pour désactiver un fournisseur (l'authorize renverra vers le login avec une erreur).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Email (vérification d'adresse) ---
# URL publique du FRONT : c'est elle qui construit le lien de vérification.
# Fausse en prod = lien mort dans un email déjà parti. À vérifier avant tout envoi réel.
PUBLIC_BASE_URL=http://localhost:3000
# SMTP_HOST VIDE = aucun email n'est envoyé, le lien est seulement écrit dans les logs.
# Suffisant en dev ; en prod cela signifie qu'un inconnu ne peut PAS valider son compte.
SMTP_HOST=
SMTP_PORT=587                        # 587 = STARTTLS · 465 = TLS implicite
SMTP_USER=
SMTP_PASSWORD=
# Mode TLS : vide = déduit du port. Forcer "implicit" (465), "starttls" (587) ou "none".
SMTP_TLS=
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=IDEAXION <no-reply@ideaxion.cloud>

# --- Abstraction LLM (app/llm) ---
# mock = provider déterministe sans réseau (dev/tests, pipeline diagnostic de bout en bout).
LLM_PROVIDER=deepseek                # mock | deepseek | mistral | openai | gemini
LLM_FALLBACKS=mistral                # repli(s) si le primaire échoue (clé requise), ex. "mistral,openai"
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Modèles (surchargables) — petits modèles par défaut (coût freemium).
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-small-latest
OPENAI_MODEL=gpt-4o-mini
# Paramètres d'appel (température basse = reproductibilité ; timeout LLM = 30s).
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- Stockage objet (MinIO, S3-compatible) ---
# ENDPOINT INTERNE : par où l'api et le worker joignent MinIO. En docker-compose,
# c'est `minio:9000` (injecté par le compose, cf. x-app-env) — un nom de réseau Docker.
MINIO_ENDPOINT=localhost:9000
# ENDPOINT PUBLIC : celui qui doit apparaître dans les URLs présignées (téléchargement
# d'un bilan, upload d'un document). La signature couvre l'hôte : signée avec l'endpoint
# interne, l'URL est inexploitable par un navigateur — c'est la panne la plus coûteuse
# du produit, le porteur ne récupère pas son bilan.
# Local hors conteneur : identique à l'interne. En prod : l'URL publique du stockage.
MINIO_PUBLIC_ENDPOINT=localhost:9000
# HTTPS côté public uniquement (reverse proxy en terminaison TLS devant MinIO en clair).
# Vide = on reprend MINIO_SECURE.
MINIO_PUBLIC_SECURE=
MINIO_ACCESS_KEY=ideaxion
MINIO_SECRET_KEY=ideaxion-secret
MINIO_BUCKET=ideaxion
MINIO_SECURE=false                   # true en prod (HTTPS)
MINIO_REGION=
MINIO_TIMEOUT_SECONDS=5
MINIO_MAX_ATTEMPTS=3
MINIO_CIRCUIT_FAILURE_THRESHOLD=3
MINIO_CIRCUIT_RESET_SECONDS=30
